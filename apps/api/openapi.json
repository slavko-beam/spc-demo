{
  "openapi": "3.1.0",
  "info": {
    "title": "SPC Todo API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "List": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "openCount": {
            "type": "integer"
          }
        },
        "required": ["id", "name", "openCount"]
      },
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "listId": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": ["id", "listId", "title", "completed", "createdAt"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "Affected": {
        "type": "object",
        "properties": {
          "affected": {
            "type": "integer"
          }
        },
        "required": ["affected"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/lists": {
      "get": {
        "operationId": "listLists",
        "responses": {
          "200": {
            "description": "All lists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/List"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createList",
        "requestBody": {
          "description": "New list",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/List"
                }
              }
            }
          }
        }
      }
    },
    "/lists/{listId}/todos": {
      "get": {
        "operationId": "listTodos",
        "parameters": [
          {
            "schema": {
              "type": ["integer", "null"]
            },
            "required": false,
            "name": "listId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Todos in the list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTodo",
        "parameters": [
          {
            "schema": {
              "type": ["integer", "null"]
            },
            "required": false,
            "name": "listId",
            "in": "path"
          }
        ],
        "requestBody": {
          "description": "New todo",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["title"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created todo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/todos/completed": {
      "post": {
        "operationId": "setTodosCompleted",
        "requestBody": {
          "description": "Todos to update",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 1
                  },
                  "completed": {
                    "type": "boolean"
                  }
                },
                "required": ["ids", "completed"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Number of todos updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Affected"
                }
              }
            }
          }
        }
      }
    },
    "/todos/delete": {
      "post": {
        "operationId": "deleteTodos",
        "requestBody": {
          "description": "Todos to delete",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 1
                  }
                },
                "required": ["ids"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Number of todos deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Affected"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
